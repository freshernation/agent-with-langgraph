# Copy this file to .env and fill it in. Never commit .env.
#
# The model. Every test uses the scripted model and needs nothing here.
#   fake    - no key, no network, no cost. The default.
#   claude  - needs ANTHROPIC_API_KEY
#   openai  - needs OPENAI_API_KEY
AGENT_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: which model each provider uses. Leave blank for the course default.
AGENT_CLAUDE_MODEL=
AGENT_OPENAI_MODEL=

# Langfuse - your own project on Langfuse Cloud (SETUP.md step 6).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Studio must never send traces to LangSmith. Langfuse is the only tracing tool.
LANGSMITH_TRACING=false
